// Wavy data model.
//
// User identity lives in Supabase Auth (`auth.users`). Prisma never joins
// across schemas, so every `userId`/`createdById` here is a plain indexed
// text column holding the auth uid, joined in application code via UserProfile.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors the signed-in Supabase user; created on first authenticated request.
model UserProfile {
  id        String   @id // = Supabase auth uid
  email     String
  name      String   @default("")
  createdAt DateTime @default(now())

  @@index([email])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocRole {
  EDITOR
  VIEWER
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  documents   Document[]

  @@index([createdById])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String? // optional "for this address only" marker; link works regardless in V1
  role           OrgRole   @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedById   String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Document {
  id             String   @id @default(uuid())
  organizationId String
  title          String   @default("Untitled")
  icon           String? // emoji page icon
  content        Json     @default("{}") // TipTap JSON doc
  isOrgWide      Boolean  @default(false) // visible to every org member
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  DocumentPermission[]

  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([createdById])
}

model DocumentPermission {
  id         String  @id @default(uuid())
  documentId String
  userId     String
  role       DocRole @default(VIEWER)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}
